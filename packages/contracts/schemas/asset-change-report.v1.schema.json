{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brashrobotics.com/twin/asset-change-report.v1.schema.json",
  "title": "Brash Asset Change Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeSetId", "draftId", "canonicalFrameId", "baseline", "observations", "policy", "coverage", "summary", "changes", "createdBy", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "brash.asset-change-report/v1" },
    "changeSetId": { "$ref": "#/$defs/identifier" },
    "draftId": { "$ref": "#/$defs/identifier" },
    "canonicalFrameId": { "type": "string", "minLength": 1 },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["assetSetId", "revision", "bindingId", "sha256"],
      "properties": {
        "assetSetId": { "$ref": "#/$defs/identifier" }, "revision": { "type": "integer", "minimum": 1 },
        "bindingId": { "$ref": "#/$defs/identifier" }, "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateSetId", "bindingId", "sha256"],
      "properties": {
        "candidateSetId": { "$ref": "#/$defs/identifier" }, "bindingId": { "$ref": "#/$defs/identifier" }, "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["matchingAlgorithm", "maximumMatchDistanceMeters", "coverageMode", "coveragePaddingMeters"],
      "properties": {
        "matchingAlgorithm": { "const": "CLASS_NEAREST_NEIGHBOR" },
        "maximumMatchDistanceMeters": { "type": "number", "exclusiveMinimum": 0 },
        "coverageMode": { "const": "OBSERVED_ENVELOPE" },
        "coveragePaddingMeters": { "type": "number", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum", "maximum", "baselineAssetsEvaluated"],
      "properties": {
        "minimum": { "$ref": "#/$defs/vector3Array" }, "maximum": { "$ref": "#/$defs/vector3Array" },
        "baselineAssetsEvaluated": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["movedCount", "missingCount", "appearedCount", "unchangedCount", "ignoredObservationCount"],
      "properties": {
        "movedCount": { "type": "integer", "minimum": 0 }, "missingCount": { "type": "integer", "minimum": 0 },
        "appearedCount": { "type": "integer", "minimum": 0 }, "unchangedCount": { "type": "integer", "minimum": 0 },
        "ignoredObservationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "changes": {
      "type": "array", "maxItems": 5000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["changeId", "changeType", "assetId", "candidateId", "semanticClass", "confidence", "fromPosition", "toPosition", "distanceMeters", "reviewStatus"],
        "properties": {
          "changeId": { "$ref": "#/$defs/identifier" },
          "changeType": { "enum": ["MOVED", "MISSING", "APPEARED"] },
          "assetId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "candidateId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "semanticClass": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "fromPosition": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/vector3Array" }] },
          "toPosition": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/vector3Array" }] },
          "distanceMeters": { "type": ["number", "null"], "minimum": 0 },
          "reviewStatus": { "const": "REVIEW_REQUIRED" }
        }
      }
    },
    "createdBy": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "vector3Array": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "items": false }
  }
}

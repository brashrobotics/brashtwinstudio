{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brashrobotics.com/twin/semantic-observations.v1.schema.json",
  "title": "Brash Semantic Observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observationSetId", "sourceFrameId", "model", "observations"],
  "properties": {
    "schemaVersion": { "const": "brash.semantic-observations/v1" },
    "observationSetId": { "$ref": "#/$defs/identifier" },
    "sourceFrameId": { "type": "string", "minLength": 1 },
    "model": { "$ref": "#/$defs/producer" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observationId", "classId", "confidence", "position", "dimensions", "evidence"],
        "properties": {
          "observationId": { "$ref": "#/$defs/identifier" },
          "classId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "position": { "$ref": "#/$defs/vector3" },
          "dimensions": { "$ref": "#/$defs/positiveVector3" },
          "evidence": {
            "type": "array", "minItems": 1, "maxItems": 20,
            "items": { "$ref": "#/$defs/artifactIdentity" }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "vector3": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"}], "items": false },
    "positiveVector3": { "type": "array", "prefixItems": [{"type":"number","exclusiveMinimum":0},{"type":"number","exclusiveMinimum":0},{"type":"number","exclusiveMinimum":0}], "items": false },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "parametersSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "parametersSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["bindingId", "artifactSha256"],
      "properties": {
        "bindingId": { "$ref": "#/$defs/identifier" },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brashrobotics.com/twin/scene-manifest.v1.schema.json",
  "title": "Brash Scene Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mapReleaseId", "frameId", "bounds", "tiles"],
  "properties": {
    "schemaVersion": { "const": "brash.scene-manifest/v1" },
    "mapReleaseId": { "type": "string", "minLength": 1 },
    "frameId": { "type": "string", "minLength": 1 },
    "bounds": { "$ref": "#/$defs/bounds3d" },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tileId", "bounds", "levels"],
        "properties": {
          "tileId": { "type": "string", "minLength": 1 },
          "bounds": { "$ref": "#/$defs/bounds3d" },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level", "path", "mediaType", "maximumScreenError"],
              "properties": {
                "level": { "type": "integer", "minimum": 0 },
                "path": { "type": "string", "minLength": 1 },
                "mediaType": { "enum": ["model/gltf-binary", "application/vnd.brash.point-cloud-tile"] },
                "maximumScreenError": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }
    },
    "bounds3d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "$ref": "#/$defs/vector3" },
        "maximum": { "$ref": "#/$defs/vector3" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brashrobotics.com/twin/asset-candidate-report.v1.schema.json",
  "title": "Brash Asset Candidate Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateSetId", "draftId", "registrationId", "registrationAcceptance", "observations", "canonicalFrameId", "extraction", "candidates", "createdBy", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "brash.asset-candidate-report/v1" },
    "candidateSetId": { "$ref": "#/$defs/identifier" },
    "draftId": { "$ref": "#/$defs/identifier" },
    "registrationId": { "$ref": "#/$defs/identifier" },
    "registrationAcceptance": { "$ref": "#/$defs/artifactIdentity" },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": ["bindingId", "sha256", "observationSetId", "sourceFrameId"],
      "properties": {
        "bindingId": { "$ref": "#/$defs/identifier" }, "sha256": { "$ref": "#/$defs/sha256" },
        "observationSetId": { "$ref": "#/$defs/identifier" }, "sourceFrameId": { "type": "string", "minLength": 1 }
      }
    },
    "canonicalFrameId": { "type": "string", "minLength": 1 },
    "extraction": { "$ref": "#/$defs/producer" },
    "candidates": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidateId", "sourceObservationId", "suggestedClass", "confidence", "canonicalPosition", "dimensions", "evidence"],
        "properties": {
          "candidateId": { "$ref": "#/$defs/identifier" }, "sourceObservationId": { "$ref": "#/$defs/identifier" },
          "suggestedClass": { "type": "string", "minLength": 1 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "canonicalPosition": { "$ref": "#/$defs/vector3" }, "dimensions": { "$ref": "#/$defs/positiveVector3" },
          "evidence": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/artifactIdentitySha" } }
        }
      }
    },
    "createdBy": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "vector3": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"}], "items": false },
    "positiveVector3": { "type": "array", "prefixItems": [{"type":"number","exclusiveMinimum":0},{"type":"number","exclusiveMinimum":0},{"type":"number","exclusiveMinimum":0}], "items": false },
    "producer": { "type": "object", "additionalProperties": false, "required": ["name","version","configurationSha256"], "properties": { "name":{"type":"string","minLength":1}, "version":{"type":"string","minLength":1}, "configurationSha256":{"$ref":"#/$defs/sha256"} } },
    "artifactIdentity": { "type":"object", "additionalProperties":false, "required":["bindingId","sha256"], "properties":{"bindingId":{"$ref":"#/$defs/identifier"},"sha256":{"$ref":"#/$defs/sha256"}} },
    "artifactIdentitySha": { "type":"object", "additionalProperties":false, "required":["bindingId","artifactSha256"], "properties":{"bindingId":{"$ref":"#/$defs/identifier"},"artifactSha256":{"$ref":"#/$defs/sha256"}} }
  }
}

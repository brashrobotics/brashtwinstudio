{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brashrobotics.com/twin/manager-notification-message.v1.schema.json",
  "title": "Brash Manager Notification Message v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "notificationId", "siteId", "floorId", "draftId", "assetSetId", "assetRevision", "changeSetId", "reviewId", "subject", "summary", "changes", "occurredAt"],
  "properties": {
    "schemaVersion": { "const": "brash.manager-notification-message/v1" },
    "notificationId": { "$ref": "#/$defs/identifier" },
    "siteId": { "$ref": "#/$defs/identifier" },
    "floorId": { "$ref": "#/$defs/identifier" },
    "draftId": { "$ref": "#/$defs/identifier" },
    "assetSetId": { "$ref": "#/$defs/identifier" },
    "assetRevision": { "type": "integer", "minimum": 1 },
    "changeSetId": { "$ref": "#/$defs/identifier" },
    "reviewId": { "$ref": "#/$defs/identifier" },
    "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criticalCount", "warningCount", "totalCount"],
      "properties": {
        "criticalCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "totalCount": { "type": "integer", "minimum": 0 }
      }
    },
    "changes": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/change" } },
    "occurredAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeId", "changeType", "assetId", "semanticClass", "confidence", "severity"],
      "properties": {
        "changeId": { "$ref": "#/$defs/identifier" },
        "changeType": { "enum": ["MOVED", "MISSING", "APPEARED"] },
        "assetId": { "$ref": "#/$defs/identifier" },
        "semanticClass": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "severity": { "enum": ["CRITICAL", "WARNING"] }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brashrobotics.com/twin/twin-asset-changes-applied-event.v1.schema.json",
  "title": "Brash Twin Asset Changes Applied Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "aggregateType", "aggregateId", "eventType", "schemaVersion", "payload", "occurredAt"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "aggregateType": { "const": "MAP_DRAFT" },
    "aggregateId": { "$ref": "#/$defs/identifier" },
    "eventType": { "const": "TwinAssetChangesApplied.v1" },
    "schemaVersion": { "const": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "draftId", "assetSetId", "assetRevision", "changeSetId", "reviewId", "notificationRequired", "confirmedChanges"],
      "properties": {
        "schemaVersion": { "const": "brash.twin-asset-changes-applied-event/v1" },
        "draftId": { "$ref": "#/$defs/identifier" },
        "assetSetId": { "$ref": "#/$defs/identifier" },
        "assetRevision": { "type": "integer", "minimum": 1 },
        "changeSetId": { "$ref": "#/$defs/identifier" },
        "reviewId": { "$ref": "#/$defs/identifier" },
        "notificationRequired": { "type": "boolean" },
        "confirmedChanges": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/change" } }
      }
    },
    "occurredAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeId", "changeType", "assetId", "semanticClass", "confidence", "severity"],
      "properties": {
        "changeId": { "$ref": "#/$defs/identifier" },
        "changeType": { "enum": ["MOVED", "MISSING", "APPEARED"] },
        "assetId": { "$ref": "#/$defs/identifier" },
        "semanticClass": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "severity": { "enum": ["CRITICAL", "WARNING"] }
      }
    }
  }
}

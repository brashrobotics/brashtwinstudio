{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brashrobotics.com/twin/navigation-topology.v1.schema.json",
  "title": "Brash Navigation Topology v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mapReleaseId", "frameId", "nodes", "edges"],
  "properties": {
    "schemaVersion": { "const": "brash.navigation-topology/v1" },
    "mapReleaseId": { "type": "string", "minLength": 1 },
    "frameId": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "label", "kind", "position"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["WAYPOINT", "INTERSECTION", "STATION", "HOLDING_POINT"] },
          "stationId": { "type": "string", "minLength": 1 },
          "zoneIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "position": { "$ref": "#/$defs/vector3" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edgeId", "fromNodeId", "toNodeId", "directed", "lengthMeters", "travelTimeSeconds"],
        "properties": {
          "edgeId": { "type": "string", "minLength": 1 },
          "fromNodeId": { "type": "string", "minLength": 1 },
          "toNodeId": { "type": "string", "minLength": 1 },
          "directed": { "type": "boolean" },
          "lengthMeters": { "type": "number", "exclusiveMinimum": 0 },
          "travelTimeSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "speedLimitMetersPerSecond": { "type": "number", "exclusiveMinimum": 0 },
          "widthMeters": { "type": "number", "exclusiveMinimum": 0 },
          "capacity": { "type": "integer", "minimum": 1 },
          "allowedRobotClasses": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "requiredAssetIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brashrobotics.com/twin/twin-map-bundle.v1.schema.json",
  "title": "Brash Twin Map Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "mapReleaseId",
    "familyId",
    "revision",
    "status",
    "createdAt",
    "canonicalFrameId",
    "units",
    "bounds",
    "artifacts",
    "compatibility"
  ],
  "properties": {
    "schemaVersion": { "const": "brash.twin-map-bundle/v1" },
    "bundleId": { "type": "string", "minLength": 1 },
    "mapReleaseId": { "type": "string", "minLength": 1 },
    "familyId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "const": "PUBLISHED" },
    "createdAt": { "type": "string", "format": "date-time" },
    "canonicalFrameId": { "type": "string", "minLength": 1 },
    "validationReportSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Required by the Twin Studio publication use case; optional for legacy v1 consumers."
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "angle"],
      "properties": {
        "length": { "const": "m" },
        "angle": { "const": "rad" }
      }
    },
    "bounds": { "$ref": "#/$defs/bounds3d" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["navigationTopologyContract", "sceneManifestContract"],
      "properties": {
        "navigationTopologyContract": { "const": "brash.navigation-topology/v1" },
        "sceneManifestContract": { "const": "brash.scene-manifest/v1" },
        "fleetLiveOverlayContract": { "const": "brash.fleet-live-overlay/v1" }
      }
    }
  },
  "$defs": {
    "point3d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "bounds3d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "$ref": "#/$defs/point3d" },
        "maximum": { "$ref": "#/$defs/point3d" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "mediaType", "sha256", "bytes"],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "COORDINATE_FRAMES",
            "NAVIGATION_TOPOLOGY",
            "TWIN_ASSETS",
            "SEMANTIC_ZONES",
            "SCENE_MANIFEST",
            "FLOORPLAN",
            "OCCUPANCY"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brashrobotics.com/twin/asset-candidate-review.v1.schema.json",
  "title": "Brash Asset Candidate Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateSetId", "draftId", "candidateReport", "decisions", "summary", "reviewerId", "note", "reviewedAt"],
  "properties": {
    "schemaVersion": { "const": "brash.asset-candidate-review/v1" },
    "candidateSetId": { "$ref": "#/$defs/identifier" },
    "draftId": { "$ref": "#/$defs/identifier" },
    "candidateReport": { "$ref": "#/$defs/artifactIdentity" },
    "decisions": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidateId", "decision", "displayName", "assetType", "properties"],
        "properties": {
          "candidateId": { "$ref": "#/$defs/identifier" },
          "decision": { "enum": ["ACCEPTED", "REJECTED"] },
          "displayName": { "type": ["string", "null"], "maxLength": 200 },
          "assetType": { "type": ["string", "null"], "maxLength": 100 },
          "properties": { "type": "object", "maxProperties": 20, "additionalProperties": { "type": ["string", "number", "boolean"] } }
        }
      }
    },
    "summary": { "type":"object", "additionalProperties":false, "required":["acceptedCount","rejectedCount"], "properties":{"acceptedCount":{"type":"integer","minimum":0},"rejectedCount":{"type":"integer","minimum":0}} },
    "reviewerId": { "type": "string", "minLength": 1 },
    "note": { "type": ["string", "null"], "maxLength": 2000 },
    "reviewedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactIdentity": { "type":"object", "additionalProperties":false, "required":["bindingId","sha256"], "properties":{"bindingId":{"$ref":"#/$defs/identifier"},"sha256":{"$ref":"#/$defs/sha256"}} }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brashrobotics.com/draft-validation-report/v2/schema.json",
  "title": "Brash Draft Validation Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "reportId", "jobId", "draftId", "canonicalFrameId",
    "validator", "inputs", "startedAt", "completedAt", "outcome", "summary", "issues"
  ],
  "properties": {
    "schemaVersion": { "const": "brash.draft-validation-report/v2" },
    "reportId": { "$ref": "#/$defs/identifier" },
    "jobId": { "$ref": "#/$defs/identifier" },
    "draftId": { "$ref": "#/$defs/identifier" },
    "canonicalFrameId": { "type": "string", "minLength": 1 },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configurationSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "configurationSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bindingId", "artifactSha256", "role"],
        "properties": {
          "bindingId": { "$ref": "#/$defs/identifier" },
          "artifactSha256": { "$ref": "#/$defs/sha256" },
          "role": { "type": "string", "minLength": 1 },
          "reviewDecision": { "enum": ["APPROVED", "REJECTED", "INVALID"] }
        }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "outcome": { "enum": ["PASSED", "FAILED"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorCount", "warningCount", "infoCount"],
      "properties": {
        "errorCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "infoCount": { "type": "integer", "minimum": 0 }
      }
    },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "vector3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactBindingId": { "$ref": "#/$defs/identifier" },
        "coordinateFrameId": { "type": "string", "minLength": 1 },
        "jsonPointer": { "type": "string", "pattern": "^(?:|/.*)$" },
        "position": { "$ref": "#/$defs/vector3" },
        "boundsMinimum": { "$ref": "#/$defs/vector3" },
        "boundsMaximum": { "$ref": "#/$defs/vector3" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueId", "code", "severity", "message", "location"],
      "properties": {
        "issueId": { "$ref": "#/$defs/identifier" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "severity": { "enum": ["ERROR", "WARNING", "INFO"] },
        "message": { "type": "string", "minLength": 1 },
        "location": { "oneOf": [{ "$ref": "#/$defs/location" }, { "type": "null" }] }
      }
    }
  }
}

TWIN_HTTP_HOST=127.0.0.1
TWIN_HTTP_PORT=4380
TWIN_APP_ENV=development
TWIN_PERSISTENCE_MODE=postgres
TWIN_DATABASE_URL=postgres://twin:twin@127.0.0.1:5432/brash_twin
TWIN_DATABASE_SSL_MODE=disable
TWIN_DATABASE_POOL_MAX=10
TWIN_DATABASE_CONNECT_TIMEOUT_MS=5000
TWIN_DATABASE_IDLE_TIMEOUT_MS=30000
TWIN_DATABASE_STATEMENT_TIMEOUT_MS=30000
TWIN_DATABASE_APPLICATION_NAME=brash-twin-api
TWIN_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
TWIN_OBJECT_STORE_BUCKET=brash-twin-local
TWIN_OBJECT_STORE_PATH=.local/object-store
TWIN_JOB_QUEUE_URL=redis://127.0.0.1:6379/0
TWIN_RELEASE_STORE_PATH=.local/twin-store
TWIN_LOG_LEVEL=info
